# Public API origin used by the browser. Do not put secrets here.
VITE_API_BASE_URL=

# Authentication routes; confirm the final contract with the ASP.NET Core team.
VITE_AUTH_SIGN_IN_ENDPOINT=/api/auth/sign-in
VITE_AUTH_SET_PASSWORD_ENDPOINT=/api/auth/set-password
VITE_AUTH_SESSION_ENDPOINT=/api/auth/session
VITE_AUTH_SIGN_OUT_ENDPOINT=/api/auth/sign-out
VITE_AUTH_TWO_STEP_SETUP_ENDPOINT=/api/auth/two-step/setup
VITE_AUTH_TWO_STEP_VERIFY_SETUP_ENDPOINT=/api/auth/two-step/verify-setup
VITE_AUTH_TWO_STEP_SKIP_SETUP_ENDPOINT=/api/auth/two-step/skip
VITE_AUTH_TWO_STEP_VERIFY_SIGN_IN_ENDPOINT=/api/auth/two-step/verify
VITE_AUTH_FORGOT_PASSWORD_ENDPOINT=/api/auth/password/forgot
